# =============================================================================
# ai-infra — per-machine overrides
#
# All defaults live in docker-compose.yml. Create .env to override any of them.
# Compose auto-loads .env from the project root before doing variable
# interpolation, so anything set here wins over the compose-file default.
#
# `docker compose up -d` works WITHOUT this file — the compose-file defaults
# are fine for purely local use. Create .env when you want:
#   - real provider credentials (Anthropic/OpenAI keys)
#   - random secrets instead of deterministic dev defaults
#   - to swap Dex for a real IdP (Okta/Google/Azure/Keycloak)
# =============================================================================

# ── Secrets ─────────────────────────────────────────────────────────────────
# Random one-liner:
#   echo "LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)" >> .env
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# Then `docker compose down -v && docker compose up -d` to regenerate Postgres.
# LITELLM_MASTER_KEY=sk-...
# POSTGRES_PASSWORD=...

# ── Provider credentials ────────────────────────────────────────────────────
# Blank by default — /v1/* calls to that provider fail with an auth error
# until you set the key and `docker compose restart litellm`.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AZURE_API_KEY=
# AZURE_API_BASE=

# ── OIDC — swap Dex for a real IdP ──────────────────────────────────────────
# The IdP's registered redirect URI must match PROXY_BASE_URL + /sso/callback.
# PROXY_BASE_URL=http://localhost:4000
# GENERIC_CLIENT_ID=ai-gateway
# GENERIC_CLIENT_SECRET=...
# GENERIC_AUTHORIZATION_ENDPOINT=https://<idp>/oauth2/v1/authorize
# GENERIC_TOKEN_ENDPOINT=https://<idp>/oauth2/v1/token
# GENERIC_USERINFO_ENDPOINT=https://<idp>/oauth2/v1/userinfo
