# =============================================================================
# LiteLLM Gateway — Environment Configuration
#
# This file ships with safe local-dev defaults. `make init` (or `make up` on
# a fresh clone) generates ai-gateway/.env from this template, replaces the
# CHANGE-ME values with random secrets, and prompts for the Anthropic key.
# Nothing in this file should need manual editing for local use.
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway admin
# -----------------------------------------------------------------------------
# Master key for admin/root access. `make init` replaces this with
# `sk-$(openssl rand -hex 32)`.
LITELLM_MASTER_KEY=sk-CHANGE-ME

# -----------------------------------------------------------------------------
# Database (Postgres) — persists virtual keys, spend, model config, users
# -----------------------------------------------------------------------------
# `make init` replaces this with `openssl rand -hex 24`.
POSTGRES_PASSWORD=CHANGE-ME

# -----------------------------------------------------------------------------
# SSO (OIDC) — admin UI authentication via the bundled Dex identity provider.
# All values below are wired for the local stack; no edits needed.
#
# To swap in a real IdP (Okta/Google/Azure/Keycloak): change PROXY_BASE_URL
# (if you change the public hostname), GENERIC_CLIENT_ID/SECRET (registered
# in the IdP), and the three endpoint URLs. Examples by provider:
#   Okta:       https://<your-domain>.okta.com/oauth2/v1/{authorize,token,userinfo}
#   Google:     https://accounts.google.com/o/oauth2/v2/auth
#               https://oauth2.googleapis.com/token
#               https://openidconnect.googleapis.com/v1/userinfo
#   Azure AD:   https://login.microsoftonline.com/<tenant>/oauth2/v2.0/{authorize,token}
#               https://graph.microsoft.com/oidc/userinfo
#   Keycloak:   https://<host>/realms/<realm>/protocol/openid-connect/{auth,token,userinfo}
# -----------------------------------------------------------------------------

PROXY_BASE_URL=https://litellm.umairkhancis.test

GENERIC_CLIENT_ID=ai-gateway
GENERIC_CLIENT_SECRET=dev-client-secret

GENERIC_AUTHORIZATION_ENDPOINT=https://dex.umairkhancis.test/auth
GENERIC_TOKEN_ENDPOINT=https://dex.umairkhancis.test/token
GENERIC_USERINFO_ENDPOINT=https://dex.umairkhancis.test/userinfo

# -----------------------------------------------------------------------------
# Model provider credentials
# -----------------------------------------------------------------------------
# `make init` prompts for ANTHROPIC_API_KEY. Leave blank to skip — the stack
# still starts and the admin UI works, but /v1/* calls to Anthropic models
# will fail with an auth error until you set this and restart the gateway.
#
# Other providers are commented out — uncomment what you need and add the
# matching entries to ai-gateway/config.yaml.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
