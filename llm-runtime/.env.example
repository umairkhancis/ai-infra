# Copy to .env and fill in values before starting any runtime.

# HuggingFace token — required for gated models (Llama, Mistral, Gemma, etc.)
HF_TOKEN=

# ── vLLM ─────────────────────────────────────────────────────────────────────
# VLLM_MODEL: HuggingFace model ID to load.
# VLLM_SERVED_MODEL_NAME: must match the model_name in litellm-gateway/config.yaml.
#
# Swap examples:
#   llama3.2:  VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct  VLLM_SERVED_MODEL_NAME=llama3.2
#   qwen2.5:   VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct           VLLM_SERVED_MODEL_NAME=qwen2.5
#   gemma3:    VLLM_MODEL=google/gemma-3-4b-it               VLLM_SERVED_MODEL_NAME=gemma3
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
VLLM_SERVED_MODEL_NAME=llama3.2

# ── llama.cpp ─────────────────────────────────────────────────────────────────
# GGUF filename inside ./llamacpp/models/ — drop the file there before starting.
# The filename does not need to match the model name; llama.cpp ignores it in requests.
LLAMACPP_MODEL=llama-3.2-3b-instruct-q4_k_m.gguf
LLAMACPP_CTX_SIZE=8192

# ── Ollama ────────────────────────────────────────────────────────────────────
# Model pulled on native.sh startup. Container pulls on demand:
#   docker exec ollama ollama pull llama3.2
OLLAMA_MODEL=llama3.2
